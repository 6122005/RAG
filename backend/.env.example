# ==============================================================================
# Production-Grade Grounded RAG System - Environment Configuration
# ==============================================================================

# API Security
API_KEY=rag-secret-key-prod-2026

# LLM Provider Configuration ("openrouter", "gemini", "openai", or "mock")
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# Embedding Provider Configuration ("sentence-transformers", "gemini", or "openai")
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reranking Configuration
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Minimum relevance score required from cross-encoder to allow generation (prevents hallucination)
RERANK_THRESHOLD=0.10
TOP_K_RETRIEVAL=10
TOP_N_RERANK=4

# ChromaDB Persistent Storage Directory
CHROMA_PERSIST_DIR=./data/chromadb
DOCUMENT_STORE_DIR=./data/documents

# API & Server Settings
HOST=0.0.0.0
PORT=8000
RATE_LIMIT_PER_MINUTE=60
